---
interface Props {
  title: string;
  theme?: 'theme' | 'theme-brown';
  navbarType?: 'light' | 'dark';
  navbarTogglable?: boolean;
  navbarLinks?: boolean;
  showNavbar?: boolean;
  showFooter?: boolean;
  page?: string;
  footerType?: 'light' | 'dark';
}

const {
  title,
  theme = 'theme',
  navbarType = 'light',
  navbarTogglable = false,
  navbarLinks = true,
  showNavbar = true,
  showFooter = true,
  page = '',
  footerType = 'dark'
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <!-- Required meta tags -->
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">

    <!-- Favicons -->
    <link rel="apple-touch-icon" sizes="57x57" href="/assets/ico/apple-icon-57x57.png">
    <link rel="apple-touch-icon" sizes="60x60" href="/assets/ico/apple-icon-60x60.png">
    <link rel="apple-touch-icon" sizes="72x72" href="/assets/ico/apple-icon-72x72.png">
    <link rel="apple-touch-icon" sizes="76x76" href="/assets/ico/apple-icon-76x76.png">
    <link rel="apple-touch-icon" sizes="114x114" href="/assets/ico/apple-icon-114x114.png">
    <link rel="apple-touch-icon" sizes="120x120" href="/assets/ico/apple-icon-120x120.png">
    <link rel="apple-touch-icon" sizes="144x144" href="/assets/ico/apple-icon-144x144.png">
    <link rel="apple-touch-icon" sizes="152x152" href="/assets/ico/apple-icon-152x152.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/ico/apple-icon-180x180.png">
    <link rel="icon" type="image/png" sizes="192x192" href="/assets/ico/android-icon-192x192.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/ico/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="96x96" href="/assets/ico/favicon-96x96.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/assets/ico/favicon-16x16.png">
    <link rel="manifest" href="/assets/ico/manifest.json">
    <meta name="msapplication-TileColor" content="#ffffff">
    <meta name="msapplication-TileImage" content="/assets/ico/ms-icon-144x144.png">
    <meta name="theme-color" content="#ffffff">

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" integrity="sha512-1ycn6IcaQQ40/MKBW2W4Rhis/DbILU74C1vSrLJxCq57o941Ym01SwNsOMqvEBFlcgUa6xLiPY/NS5R+E6ztJQ==" crossorigin="anonymous" referrerpolicy="no-referrer" />

    <!-- Theme CSS -->
    <link rel="stylesheet" href={`/assets/css/${theme}.css`}>

    <!-- Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-SBTTQLV397"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('js', new Date());
      gtag('config', 'G-SBTTQLV397');
    </script>

    <!-- Google Ads -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=AW-927628928"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('js', new Date());
      gtag('config', 'AW-927628928');
    </script>

    <!-- Conversions tracking -->
    <script is:inline>
      function gtag_report_conversion(url) {
        var callback = function () {
          if (typeof (url) != 'undefined') {
            //window.location = url;
          }
        };
        gtag('event', 'conversion', {
          'send_to': 'AW-927628928/ez_oCP2Pvt0BEID9qboD',
          'event_callback': callback
        });
        return false;
      }
    </script>

    <title>{title}</title>
  </head>
  <body>
    {showNavbar && (
    <!-- Navbar -->
    <nav class={`navbar navbar-expand-xl navbar-${navbarType} ${navbarTogglable ? 'navbar-togglable' : ''} fixed-top`}>
      <div class="container">
        <!-- Brand -->
        <a class="navbar-brand" href="/">
          <svg class="navbar-brand-svg" viewBox="0 0 200 80" xmlns="http://www.w3.org/2000/svg">
            <text x="40" y="70" font-family="Edwardian Script ITC" font-size="80" letter-spacing="-.025em" fill="currentColor">D</text>
          </svg>
        </a>

        {navbarLinks && (
          <>
            <!-- Toggler -->
            <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarCollapse" aria-controls="navbarCollapse" aria-expanded="false" aria-label="Toggle navigation">
              <span class="navbar-toggler-icon"></span>
            </button>

            <!-- Collapse -->
            <div class="collapse navbar-collapse" id="navbarCollapse">
              <!-- Links -->
              <ul class="navbar-nav ml-auto">
                <li class={`nav-item ${page === 'home' ? 'active' : ''}`}>
                  <a href="/home" class="nav-link">Home</a>
                </li>
                <li class={`nav-item ${page === 'services' ? 'active' : ''}`}>
                  <a href="/services" class="nav-link">Services</a>
                </li>
                <li class={`nav-item ${page === 'about' ? 'active' : ''}`}>
                  <a href="/about" class="nav-link">About us</a>
                </li>
                <li class={`nav-item ${page === 'contact' ? 'active' : ''}`}>
                  <a href="/contact" class="nav-link">Contact us</a>
                </li>
                <li class="nav-item-divider">
                  <span class="nav-link"><span></span></span>
                </li>
                <li class={`nav-item ${page === 'sign-in' ? 'active' : ''}`}>
                  <a href="/sign-in" class="nav-link">Client Login</a>
                </li>
              </ul>
            </div>
          </>
        )}
      </div>
    </nav>
    )}

    <!-- Main Content -->
    <slot />

    {showFooter && (
    <!-- Footer -->
    <footer class={`section bg-${footerType}`}>
      <!-- Triangles -->
      <div class="bg-triangle bg-triangle-light bg-triangle-bottom bg-triangle-left"></div>
      <div class="bg-triangle bg-triangle-light bg-triangle-bottom bg-triangle-right"></div>

      <!-- Content -->
      <div class="container">
        <div class="row align-self-center">
          <div class="col-md-auto"></div>
          <div class="col-md">
            <!-- Links -->
            <ul class="list-unstyled list-inline text-md-right"></ul>
          </div>
        </div>
        <div class="row align-items-center">
          <div class="col-md">
            <!-- Copyright -->
            <p class="text-white text-muted">
              <small>&copy; Copyright <span class="current-year"></span> Donaldson Attorneys. All rights reserved.</small>
            </p>
          </div>
          <div class="col-md">
            <!-- Social links -->
            <ul class="list-inline list-unstyled text-md-right"></ul>
          </div>
        </div>
      </div>
    </footer>
    )}

    <!-- External CDN Scripts (inline to avoid CORS issues) -->
    <script is:inline src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script is:inline src="https://maps.googleapis.com/maps/api/js?key=AIzaSyB-Aoj9NErOfXlFpgMzOurOhgPWzblqmG4"></script>
    <script is:inline src="https://www.google.com/recaptcha/enterprise.js?render=6Lc2sfMZAAAAANHrN90an-E6_cDU65TQ6Pb6RR3Y"></script>
    <script is:inline src="https://cdn.jsdelivr.net/npm/bootstrap@4.4.1/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Local Scripts -->
    <script src="../scripts/js/animation.js"></script>
    <script src="../scripts/js/alert.js"></script>
    <script src="../scripts/js/code.js"></script>
    <script src="../scripts/js/dropdown.js"></script>
    <script src="../scripts/js/faq.js"></script>
    <script src="../scripts/js/fullpage.js"></script>
    <script src="../scripts/js/map.js"></script>
    <script src="../scripts/js/modal.js"></script>
    <script src="../scripts/js/navbar.js"></script>
    <script src="../scripts/js/newsletter.js"></script>
    <script src="../scripts/js/polyfill.js"></script>
    <script src="../scripts/js/slider.js"></script>
    <script src="../scripts/js/testimonials.js"></script>
    <script src="../scripts/js/year.js"></script>
    <script src="../scripts/js/randomvideo.js"></script>
    <script src="../scripts/js/contactus.js"></script>
    <script src="../scripts/js/email_from_reg.js"></script>
  </body>
</html>
