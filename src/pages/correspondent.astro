---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Donaldson Attorneys | Correspondent Services"
  navbarType="light"
  navbarTogglable={false}
  page="services"
  footerType="dark"
>
  <!-- HERO
    ================================================== -->
  <section class="section section-top section-full">

    <!-- Cover -->
    <div class="bg-cover" style="background-image: url(/assets/img/20.jpg)">
    </div>

    <!-- Overlay -->
    <div class="bg-overlay"></div>

    <!-- Triangles -->
    <div class="bg-triangle bg-triangle-light bg-triangle-left bg-triangle-bottom"></div>
    <div class="bg-triangle bg-triangle-light bg-triangle-right bg-triangle-bottom"></div>

    <!-- Content -->
    <div class="container">
      <div class="row align-items-center">
        <div class="col-lg-5">

          <!-- Preheading -->
          <p class="font-weight-medium text-xs text-uppercase text-white text-muted" data-toggle="animation" data-animation="fadeUp" data-animation-order="0" data-animation-trigger="load">
            Randburg, Johannesburg
          </p>

          <!-- Heading -->
          <h1 class="text-white mb-4">
            Correspondent Attorneys
          </h1>

          <!-- Subheading -->
          <p class="text-white text-muted mb-5 mb-lg-0" data-toggle="animation" data-animation="fadeUp" data-animation-order="2" data-animation-trigger="load">
            Assisting attorneys in running matters in Courts situated in areas beyond their jurisdiction
          </p>

        </div>
        <div class="col-lg-5 offset-lg-2">

          <!-- Form -->
          <div class="form-styled bg-white mb-4">
            <!-- Form -->
            <form id="messageUs" >
                <!-- Heading -->
                <h4 class="form-heading mb-4">
                    Contact us now:
                </h4>
                <div class="form-row d-flex flex-row align-items-end">
                    <div class="col-md-6 flex-grow-1">

                        <!-- Email -->
                        <label>Email address</label>
                        <div class="input-group">
                            <input type="email" class="form-control order-1" name="contact-email" id="contactEmail">
                            <div class="input-group-append order-0">
                                <div class="input-group-text">
                                    <svg class="input-group-icon icon-offset icon icon-envelope"
                                        viewBox="0 0 106 106" xmlns="http://www.w3.org/2000/svg"
                                        xmlns:xlink="http://www.w3.org/1999/xlink">
                                        <path transform="translate(3 3)" d="
                            M0 30 V 10 H 100 V 90 H 0 V 30 L 50 60 L 100 30">
                                        </path>
                                    </svg>
                                </div>
                            </div>
                        </div>

                    </div>
                    <div class="col-md-6" id="successmsg">

                        <!-- Submit -->
                        <button type="submit" class="btn btn-outline-primary">
                            Send message
                        </button>
                        <!-- <p></p> -->


                    </div>

                </div> <!-- / .form-row -->
                <input type="text" class="d-none" name="contact-name" id='contactName'>
                <input type="text" class="d-none" name="message" id='message'>



            </form>
          </div>

          <!-- Caption -->
          <p class="d-flex align-items-center justify-content-center">

            <!-- Icon -->
            <span class="icon icon-support icon-2x text-primary mr-2"></span>

            <span class="text-white mr-3">
              Or call us:
            </span>

            <!-- Phone -->
            <a href="tel:011 568 4409" class="text-white">
              011 568 4409
            </a>

          </p>

        </div>
      </div> <!-- / .row -->
    </div> <!-- / .container -->

  </section>

  <!-- ABOUT
    ================================================== -->
  <section class="section bg-light">

    <!-- Triangles -->
    <div class="bg-triangle triangle-dark bg-triangle-left bg-triangle-top"></div>
    <div class="bg-triangle triangle-dark bg-triangle-right bg-triangle-bottom"></div>

    <!-- Content -->
    <div class="container">
      <div class="row align-items-center">
        <div class="col-md-6 col-lg-7">

          <!-- Image -->
          <div class="img-effect img-effect-info mb-5 mb-md-0">

            <!-- Info -->
            <div class="img-effect-info-popup">

              <!-- Icon -->
              <div class="img-effect-info-popup-icon">
                <i class="fas fa-building"></i>
              </div>

              <!-- Content -->
              <div class="img-effect-info-popup-content">
               Let our trusted team assist you
              </div>

            </div>

            <!-- Image -->
            <img src="/assets/img/24.jpg" class="img-fluid">

          </div>

        </div>
        <div class="col-md-6 col-lg-4 offset-lg-1">

          <!-- Heading -->
          <h2 class="heading mb-4">
            Assisting attorneys in running matters in Courts situated in areas beyond their jurisdiction, <span class="text-primary"> professionally and efficiently </span>
          </h2>

          <!-- Content -->
          <ul class="text-muted">
            <li>Jurisdiction of the following Courts:
              <ul style="padding-left: 30px;">
                <li>Johannesburg Labour Court</li>
                <li>The High Court of South Africa, Gauteng Local Division, Johannesburg</li>
                <li>Randburg Magistrate's Court</li>
                <li>Roodepoort Magistrate's Court</li>
                <li>Krugersdorp Magistrate's Court</li>
                <li>Newlands Magistrate's Court</li>
                <li>Pretoria High Court</li>
              </ul>
            </li>
            <li>Our fees for all correspondent services are on the relevant party and party scale</li>
          </ul>

        </div>
      </div> <!-- / .row -->
    </div> <!-- / .container -->

  </section>

  <!-- FEATURES
    ================================================== -->
  <section class="section bg-dark">

    <!-- Triangles -->
    <div class="bg-triangle bg-triangle-dark bg-triangle-left bg-triangle-top"></div>

    <!-- Content -->
    <div class="container">
      <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">

          <!-- Heading -->
          <h2 class="text-center text-white mb-4">
            Our services
          </h2>

        </div>
      </div> <!-- / .row -->
      <div class="row">
        <div class="col-md-4">

          <!-- Item -->
          <div class="text-center mb-5 mb-md-0">

            <!-- Icon -->
            <div class="text-primary mb-4">
              <span class="icon icon-cart icon-2x"></span>
            </div>

            <!-- Heading -->
            <h4 class="mb-3 text-white font-weight-light">
              Extensive and accomplished experience in civil litigation and in the areas of law pertaining to the National Credit Act and the application thereof
            </h4>

          </div>

        </div>
        <div class="col-md-4">

          <!-- Item -->
          <div class="text-center mb-5 mb-md-0">

            <!-- Icon -->
            <div class="text-primary mb-4">
              <span class="icon icon-clock icon-2x"></span>
            </div>

            <!-- Heading -->
            <h4 class="mb-3 text-white font-weight-light">
              Proficient in presenting Applications for consumers to be placed under Debt Review, as well as in opposing such Applications on behalf of Credit Providers
            </h4>

          </div>

        </div>
        <div class="col-md-4">

          <!-- Item -->
          <div class="text-center">

            <!-- Icon -->
            <div class="text-primary mb-4">
              <span class="icon icon-support icon-2x"></span>
            </div>

            <!-- Heading -->
            <h4 class="mb-3 text-white font-weight-light">
              Processes, service and filing of documents and/or appearances
            </h4>



          </div>

        </div>
      </div> <!-- / .row -->
    </div> <!-- / .container -->

  </section>

  <!-- CTA
    ================================================== -->
  <section class="section">

    <!-- Triangles -->
    <div class="bg-triangle bg-triangle-light bg-triangle-top bg-triangle-left"></div>
    <div class="bg-triangle bg-triangle-light bg-triangle-bottom bg-triangle-right"></div>

    <!-- Content -->
    <div class="container">
      <div class="row align-items-center justify-content-center">
        <div class="col-md-8">

          <!-- Heading -->
          <h3 class=" mb-4">
            Wait no more. Contact us now
          </h3>

          <!-- Content -->
          <p class=" text-muted mb-4 mb-md-0">
            Let us help you
          </p>

        </div>
        <div class="col-md-4">

          <!-- Button -->
          <a href="/contact" class="btn btn-outline-primary">
            Contact us
          </a>

        </div>
      </div> <!-- / .row -->
    </div> <!-- / .container -->

  </section>
</BaseLayout>
