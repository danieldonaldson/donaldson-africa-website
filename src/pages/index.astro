---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Donaldson Attorneys | Welcome" showNavbar={false} showFooter={false}>
  <!-- HERO -->
  <section class="section section-top section-full">
    <!-- Video -->
    <div class="bg-video">
      <video class="bg-video-media" id="bg-video" autoplay playsinline muted loop>
        <source id="random-src" src="/assets/video/1.mp4" type="video/mp4">
        HTML video is not supported by your browser.
      </video>
    </div>

    <!-- Overlay -->
    <div class="front-bg-overlay"></div>

    <!-- Triangles -->
    <div class="bg-triangle bg-triangle-light bg-triangle-bottom bg-triangle-left"></div>
    <div class="bg-triangle bg-triangle-light bg-triangle-bottom bg-triangle-right"></div>

    <!-- Content -->
    <div class="container">
      <div class="row justify-content-center align-items-center">
        <div class="col-md-10 col-lg-10">
          <!-- Preheading -->
          <p
            class="logofont font-weight-medium text-center text-uppercase text-white text-muted"
            data-toggle="animation"
            data-animation="fadeUp"
            data-animation-order="0"
            data-animation-trigger="load">
            D
          </p>

          <!-- Heading -->
          <h1
            class="text-white text-center mb-4 frontpagefont"
            data-toggle="animation"
            data-animation="fadeUp"
            data-animation-order="1"
            data-animation-trigger="load">
            Donaldson Attorneys Inc.
          </h1>

          <div class="row justify-content-center align-items-center">
            <div class="col-md-4">
              <p
                class="text-center mb-0"
                data-toggle="animation"
                data-animation="fadeUp"
                data-animation-order="3"
                data-animation-trigger="load">
                <a href="/sign-in" class="btn btn-outline-primary text-white">
                  Client login
                </a>
              </p>
            </div>

            <div class="col-md-4">
              <p
                class="text-center mb-0"
                data-toggle="animation"
                data-animation="fadeUp"
                data-animation-order="3"
                data-animation-trigger="load">
                <a href="/home" class="btn btn-outline-primary text-white">
                  More Info
                </a>
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
